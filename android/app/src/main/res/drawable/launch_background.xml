<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <!-- Brand mint circle: the white half of the pill needs a dark-enough fill
         behind it to stay visible on the light splash background. -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="160dp" android:height="160dp" />
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>

    <!-- Pill logo (white + coral halves) centred inside the circle. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
